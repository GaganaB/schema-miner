{
  "metadata": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "experiment_id": "",
    "title": "Stroop Task Process Schema",
    "task_variant": {
      "type": "string",
      "enum": [
        "Color-Word Stroop",
        "Emotional Stroop",
        "Numerical Stroop",
        "Spatial Stroop",
        "Bilingual Stroop",
        "Counting Stroop",
        "Face Stroop",
        "Other"
      ]
    },
    "sample": {
      "sample_size": {
        "min": 1
	  }
      "age_range": {
        "min": 4,
        "max": 73
      },
      "mean_age": 35,

      "sex": {
        "male": null,
        "female": null,
        "other": null
      },

      "clinical_population": false,

      "practice": {
        "duration_days": 45,
        "practice_trials": null,
        "monitored": null
      }
    }
  },

  "stimuli": {
    "colors": ["red", "blue", "green", "yellow"],
    "conditions": ["congruent", "incongruent", "neutral"],
    "words": [
      "neutral",
      "emotional",
      "positive",
      "negative"
    ],

    "font": null,
    "font_size": 16,
    "background_color": "white",
    "display_calibration": {
      "type": "object",
      "properties": {
        "luminance": {
            "type": "number",
        	},
        "contrast": {
        	"type": "number",
            }
  },

  "task": {
    "target_dimension": null,
    "ignored_dimension": null,
    "response": {

	  "modality": {
        "type": "string",
        "enum": [
            "verbal",
            "manual"
        ],
        "default": "verbal"
    }

      "mapping": {                    
		"type": "string",
        "enum": [
            "name_ink_color",
            "read_word"
        ],
	},

    "keys": ["Verbal response", "Manual keypress",]
    }
  },

  "timing": {
    "stimulus": {
      "type": "integer",
      "minimum": 500,
      "maximum": 2000,
      "unit": "ms"
    },

    "rsi": {
      "type": "integer",
      "minimum": 500,
      "maximum": 1500,
      "unit": "ms"
    },

    "isi": {
      "type": "integer",
      "minimum": 500,
      "maximum": 1500,
      "unit": "ms"
    },

    "iti": {
      "type": "integer",
      "minimum": 500,
      "maximum": 1500,
      "unit": "ms"
    }
  },

  "design": {
    "within_subject": null,
    "between_subject": null,
    "factors": [],
    "blocks": null,
    "trials": {
	  "minimum": 20,
    },
    "enum": ["Randomized", "Counterbalanced"]
  },

  "instruments": {

    "software": {
        "type": "string",
        "enum": [
            "PsychoPy",
            "E-Prime",
            "MATLAB Psychtoolbox"
        ],
    },

    "display": {
        "type": "object",
        "properties": {
            "luminance": {
            "type": "number",
            "type": "candelas per square meter."
            },
            "contrast": {
            "type": "number",
            }
        },
    }, 

   "device": [
        "keyboard",
        "response_pad",
        "voice_key",
        "touchscreen"
    ],

    "rt_precision": {
        "type": "number",
        "minimum": 0.001,
        "unit": "Millisecond resolution"
    },
  },

  "behavior": {
     "type": "object",
     "properties": {
            "reaction_time": {
              "type": "object",
              "properties": {
                "congruent":   { "type": "array", "items": { "type": "number", "minimum": 200, "maximum": 3000 } },
                "incongruent": { "type": "array", "items": { "type": "number", "minimum": 200, "maximum": 3000 } },
                "neutral":     { "type": "array", "items": { "type": "number", "minimum": 200, "maximum": 3000 } },
                "emotional":   { "type": "array", "items": { "type": "number", "minimum": 200, "maximum": 3000 } }
              }
    },
    "error_rate": {
              "type": "object",
              "properties": {
                "congruent":   { "type": "number", "minimum": 0, "maximum": 100, "default": 0 },
                "incongruent": { "type": "number", "minimum": 0, "maximum": 100, "default": 0 },
                "neutral":     { "type": "number", "minimum": 0, "maximum": 100, "default": 0 },
                "emotional":   { "type": "number", "minimum": 0, "maximum": 100, "default": 0 }
              }
    },
    "interference_score": { "type": "number", "minimum": 0, "default": 0 },
    "practice_effect": {
              "type": "object",
              "properties": {
                "rt_difference":    { "type": "number", "minimum": 0, "default": 0 },
                "error_difference": { "type": "number", "minimum": 0, "default": 0 }
              },
            },
          },
        },
  },

  "neuroimaging": {
    "modality": ["eeg", "fmri"],

    "eeg": {
       "properties": {
                    "eeg": {
                        "type": "object",
                        "properties": {
                            "capacity": {
                                "type": "number",
                                "minimum": 32,
                                "maximum": 128
                            },
                            "sampling_rate": {
                                "unit": "Hz",
                                "type": "number",
                                "minimum": 500,
                                "maximum": 1000,
                                "default": 500
                            },
                            "impedance": {
                                "type": "number",
                                "minimum": 5000,
                                "maximum": 10000,
                                "default": 7500
                            },
                            "reference": {
                                "type": "string"
                            },
                            "channels": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "event_markers": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                  },

    "fmri": {
                        "type": "object",
                        "properties": {
                            "scanner_type": {
                                "type": "string"
                            },
                            "tr": {
                                "unit": "ms",
                                "type": "number",
                                "minimum": 2000,
                                "maximum": 2500,
                                "default": 2000
                            },
                            "te": {
                                "unit": "ms",
                                "type": "number",
                                "minimum": 20,
                                "maximum": 40,
                                "default": 30
                            },
                            "voxel_size": {
                                "unit": "mm",
                                "type": "number",
                                "minimum": 2,
                                "maximum": 3,
                                "default": 2.5
                            },
                            "design": {
                                "type": "string",
                                "enum": [
                                    "event_related",
                                    "block_design"
                                ]
                            },
                         "properties": {
                "x": { "type": "number", "minimum": 2, "maximum": 3 },
                "y": { "type": "number", "minimum": 2, "maximum": 3 },
                "z": { "type": "number", "minimum": 2, "maximum": 3 }
              },
                        },
                    },
 
"model": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["drift_diffusion", "conflict_monitoring", "None"]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },

    "analysis": {
      "type": "object",
      "properties": {
        "outliers": {
          "type": "object",
          "properties": {
            "sd": { "type": "number", "minimum": 1 },
            "min_rt": { "type": "integer", "minimum": 200 },
            "max_rt": { "type": "integer", "minimum": 2000 }
          }
        },
        "accuracy_adjusted": { "type": "boolean" },
        "method": {
          "type": "string",
          "enum": ["within_subject_anova", "mixed_effects", "other"]
        }
      },
      "required": ["outliers"]
    },

    "clinical": {
      "type": "object",
      "properties": {
        "diagnosis": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ADHD",
              "depression",
              "schizophrenia",
              "frontal_lobe_dysfunction",
              "aging"
            ]
          }
        },
        "coupling": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
